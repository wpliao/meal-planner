# Copy to .dev.vars only for local development. Never commit .dev.vars.
# The local identity adapter does not require these values, but keeping the
# names here documents the secrets used by the named Cloudflare environments.
# Named development and production environments must use distinct real values.
CF_ACCESS_AUD=replace-with-the-environment-access-application-audience-tag
BOOTSTRAP_OWNER_EMAIL=owner@example.test
