{
  "name": "family-meal-planner",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "vite build",
    "cf:typegen": "wrangler types",
    "dev": "bash ./scripts/dev.sh",
    "dev:e2e": "bash ./scripts/dev-e2e.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0",
    "setup": "CI=true pnpm install --frozen-lockfile && pnpm run setup:browsers",
    "setup:browsers": "playwright install --with-deps chromium webkit",
    "test": "pnpm test:unit && pnpm test:worker",
    "test:coverage": "pnpm test:coverage:unit && pnpm test:coverage:worker",
    "test:coverage:unit": "vitest run --config vitest.config.ts --coverage",
    "test:coverage:worker": "vitest run --config vitest.worker.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -b",
    "verify": "./scripts/verify.sh"
  },
  "dependencies": {
    "@mantine/core": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "jose": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@cloudflare/vitest-plugin": "1.8.4",
    "@cloudflare/workers-types": "5.20261118.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-istanbul": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.164.0"
  },
  "pnpm": {
    "overrides": {
      "undici@7.29.0": "7.29.1"
    }
  }
}
