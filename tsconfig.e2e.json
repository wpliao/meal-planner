{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    // Playwright specs legitimately contain browser-context code inside
    // page.evaluate, so this project needs the DOM library. The node project
    // deliberately does not.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["tests/e2e"]
}
