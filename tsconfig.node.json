{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    // vitest.worker.config.ts builds the nutrition fixture with the operator
    // loader, whose imports carry explicit .ts extensions.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.worker.config.ts",
    "playwright.config.ts",
    "src/operations/nutrition-dataset/dataset.ts",
    "src/operations/nutrition-dataset/statements.ts",
    "src/shared/nutrition.ts"
  ]
}
