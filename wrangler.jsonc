{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-meal-planner",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The top-level configuration selects the deterministic local identity
  // adapter (APP_ENV "local"). It exists for local development and tests only,
  // so it must never be publishable. These are inheritable keys; both named
  // environments re-enable them explicitly below.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "APP_ENV": "local",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-meal-planner-local",
      "database_id": "local",
    },
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "family-meal-planner-local",
    },
  ],
  "env": {
    "development": {
      "name": "family-meal-planner-development",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "development",
        "CF_ACCESS_TEAM_DOMAIN": "https://dannyliao.cloudflareaccess.com",
      },
      "secrets": {
        "required": ["CF_ACCESS_AUD", "BOOTSTRAP_OWNER_EMAIL"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "family-meal-planner-dev-d1",
          "database_id": "5f5e98ba-7b27-4fcf-8c2b-ab1605461082",
        },
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "family-meal-planner-dev-uploads-r2",
        },
      ],
    },
    "production": {
      "name": "family-meal-planner-production",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "CF_ACCESS_TEAM_DOMAIN": "https://dannyliao.cloudflareaccess.com",
      },
      "secrets": {
        "required": ["CF_ACCESS_AUD", "BOOTSTRAP_OWNER_EMAIL"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "family-meal-planner-prod-d1",
          "database_id": "d944b652-580f-437e-b7ce-21818525c46c",
        },
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "family-meal-planner-prod-uploads-r2",
        },
      ],
    },
  },
}
